# build outputs (target-*: the per-feature target directories crates/glm53f-rank/README.md uses)
/target/
/target-*/
/build*/
/dist/
*.o
*.so
*.cubin
*.fatbin

# local runs, logs and scratch (keep receipts that are meant to be public in docs/)
/runs/
/scratch/
*.log

# weights and large fixtures never belong here (*.exl3: a rank directory's layer images)
*.safetensors
*.gguf
*.exl3

# environment
.env
*.env
.venv/
__pycache__/

# oracle golden payloads: regenerated deterministically by oracle/golden_layers.py; manifests (with sha256) stay tracked
oracle/goldens/**/*.bin
