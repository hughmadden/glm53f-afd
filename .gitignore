# build outputs
/target/
/build*/
/dist/
*.o
*.so
*.cubin
*.fatbin

# local runs, logs and scratch (keep receipts that are meant to be public in docs/)
/runs/
/scratch/
*.log

# weights and large fixtures never belong here
*.safetensors
*.gguf

# environment
.env
*.env
.venv/
__pycache__/

# oracle golden payloads: regenerated deterministically by oracle/golden_layers.py; manifests (with sha256) stay tracked
oracle/goldens/**/*.bin
